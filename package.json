{
  "name": "miam",
  "version": "1.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "e2e": "playwright test",
    "bff": "node --env-file-if-exists=.env server/index.js",
    "test:bff": "node --test --experimental-test-coverage \"server/test/*.test.js\"",
    "coverage:bff": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage-bff/lcov.info \"server/test/*.test.js\"",
    "test:all": "npm run test:coverage && npm run test:bff && npm run e2e"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/roboto": "^5.3.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^5.0.4",
    "dotenv": "^18.0.8",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  },
  "description": "MIAM - MFA Incident Access Management : console d'administration des comptes TOTP, appareils de confiance et sessions SSO de CAS.",
  "license": "CC-BY-NC-SA-4.0"
}
