# Configuration du module BFF (npm run bff). Copier en `.env` (ignoré par git) et adapter.
# En conteneur, ces variables sont passées à `docker run -e` / docker-compose.
# Détail de chaque variable : docs/exploitation/configuration.md.
#
# Les valeurs `a_renseigner` sont à remplacer : en production, le démarrage est REFUSÉ tant
# qu'elles restent telles quelles.

# ---------------------------------------------------------------------------------------------
# Mode d'exécution
# ---------------------------------------------------------------------------------------------
# production : refuse de démarrer sans secrets ni ROLE_ADMIN_GROUPS (valeur à conserver sur tout
# serveur). Hors production (poste de développement), les manques ne sont que des avertissements
# et tout utilisateur authentifié devient administrateur : ne jamais l'utiliser sur un serveur partagé.
NODE_ENV=production

# Port d'écoute. 80 par défaut (droits particuliers requis sous Linux : conteneur, root ou
# CAP_NET_BIND_SERVICE). Sur un poste, utiliser par exemple PORT=3000.
PORT=80

# ---------------------------------------------------------------------------------------------
# CAS
# ---------------------------------------------------------------------------------------------
# Adresse du CAS vue par le module BFF : HÔTE + CONTEXTE, tel que défini par
# `server.servlet.context-path` dans l'application.yml du CAS (/sso, /cas, /user, ou aucun).
# C'est la SEULE valeur à modifier quand le contexte change : API actuator (<CAS_BASE_URL>/actuator) et
# l'adresse vue du navigateur (le chemin de CAS_BASE_URL) en découlent.
CAS_BASE_URL=http://cas.exemple.fr/sso

# Si le navigateur joint le CAS par un autre hôte ou port que MIAM (ex. CAS sur :9000, MIAM sur :80),
# donner l'origine seule : le contexte de CAS_BASE_URL y est ajouté. Absent : même domaine que MIAM
# (reverse proxy qui relaie le contexte du CAS).
CAS_PUBLIC_ORIGIN=http://cas.exemple.fr

# Seulement si l'API Actuator ou l'adresse publique ne se déduisent pas des valeurs ci-dessus :
# CAS_ACTUATOR_BASE_URL=
# CAS_BASE_URL_PUBLIC=

# Compte HTTP Basic des API Actuator du serveur CAS (compte technique, PAS un compte utilisateur).
ACTUATOR_USERNAME=a_renseigner
ACTUATOR_PASSWORD=a_renseigner

# ---------------------------------------------------------------------------------------------
# Session et habilitations
# ---------------------------------------------------------------------------------------------
# Signe le cookie de session. Valeur aléatoire longue (ex. : openssl rand -hex 32).
SESSION_SECRET=a_renseigner

# true UNIQUEMENT si MIAM est servi en HTTPS (sinon le cookie n'est jamais renvoyé : connexion
# impossible). false pour un accès en HTTP.
COOKIE_SECURE=false

# Groupes AD (noms courts, séparés par des virgules) : profil administrateur (suppression,
# révocation, journal). OBLIGATOIRE : un agent hors des groupes n'ouvre pas de session.
ROLE_ADMIN_GROUPS=a_renseigner
# Profil consultation (lecture seule), optionnel.
# ROLE_CONSULT_GROUPS=
# Attribut CAS portant les groupes (défaut : memberOf). Doit être libéré par le service CAS.
# ROLE_ATTRIBUTE=memberOf

# ---------------------------------------------------------------------------------------------
# Réseau et limitation de débit (requêtes par minute et par IP)
# ---------------------------------------------------------------------------------------------
# Nombre de reverse proxys de confiance devant MIAM : mettre 1 derrière un proxy, sinon tous les
# agents partagent la même IP, donc la même limite.
# TRUST_PROXY=0
# LOGIN_RATE_LIMIT=20
# API_RATE_LIMIT=300
# HEALTHCHECK_RATE_LIMIT=30

# ---------------------------------------------------------------------------------------------
# Journal d'activité
# ---------------------------------------------------------------------------------------------
# Durée de conservation en mois : entier de 6 à 12 (autre valeur : démarrage refusé).
# AUDIT_RETENTION_MONTHS=12
# Fichier SQLite du journal (volume à monter en conteneur).
# AUDIT_DB_PATH=server/data/audit.db

# Niveau du journal technique (sortie standard du processus) : error, warn, info, debug.
# LOG_LEVEL=info

# ---------------------------------------------------------------------------------------------
# Présentation (optionnels)
# ---------------------------------------------------------------------------------------------
# Logo d'entreprise (URL), auteur et version du pied de page (version de package.json par défaut).
LOGO_URL=
APP_AUTHOR=
APP_VERSION=

# Page publique /informations (RGPD), vide = formulations neutres.
# PRIVACY_CONTROLLER=
# PRIVACY_DPO_CONTACT=
# PRIVACY_LEGAL_BASIS=

# ---------------------------------------------------------------------------------------------
# Bac à sable local (CAS sur le poste) : exemple de surcharge
# ---------------------------------------------------------------------------------------------
# NODE_ENV=development
# PORT=3000
# CAS_BASE_URL=http://localhost:8080/sso
# CAS_PUBLIC_ORIGIN=http://localhost:8080
# ROLE_ADMIN_GROUPS=Test
